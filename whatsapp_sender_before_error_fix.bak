
import os
import logging
import time

import httpx
from dotenv import load_dotenv

load_dotenv(override=True)

GRAPH_API_VERSION = "v23.0"
CUSTOMER_SERVICE_WINDOW_SECONDS = 24 * 60 * 60
MAX_RATE_LIMIT_RETRIES = 3
logger = logging.getLogger(__name__)


class WhatsAppSendError(RuntimeError):
    """A definite API rejection; the request was not accepted."""


class WhatsAppSendUncertain(RuntimeError):
    """The request outcome is unknown; do not retry automatically."""


def _customer_window_is_open(
    customer_message_timestamp: int | str | None,
) -> bool:
    """Require a valid, recent incoming-message timestamp."""
    if isinstance(customer_message_timestamp, bool):
        return False

    if not isinstance(customer_message_timestamp, (int, str)):
        return False

    try:
        timestamp = int(customer_message_timestamp)
    except (TypeError, ValueError, OverflowError):
        return False

    if timestamp <= 0:
        return False

    age_seconds = time.time() - timestamp
    return 0 <= age_seconds < CUSTOMER_SERVICE_WINDOW_SECONDS


def _send_text_message(
    recipient: str,
    message: str,
    enable_setting: str,
    customer_message_timestamp: int | str | None = None,
    require_open_window: bool = False,
) -> dict:
    """Send only when the appropriate safety checks permit it."""
    if os.getenv(enable_setting, "false").strip().lower() != "true":
        raise RuntimeError(
            f"WhatsApp sending is disabled by {enable_setting}"
        )

    if require_open_window and not _customer_window_is_open(
        customer_message_timestamp
    ):
        raise RuntimeError(
            "Customer-service window is closed or timestamp is missing; "
            "an approved WhatsApp template may be required."
        )

    token = os.getenv("WHATSAPP_TOKEN", "")
    phone_number_id = os.getenv("PHONE_NUMBER_ID", "")

    if not token or not phone_number_id:
        raise RuntimeError("WhatsApp sender configuration is incomplete")

    if not isinstance(recipient, str) or not recipient.strip():
        raise ValueError("Recipient is required")

    if not isinstance(message, str) or not message.strip():
        raise ValueError("Message text is required")

    url = (
        f"https://graph.facebook.com/{GRAPH_API_VERSION}/"
        f"{phone_number_id}/messages"
    )
    headers = {
        "Authorization": f"Bearer {token}",
        "Content-Type": "application/json",
    }
    payload = {
        "messaging_product": "whatsapp",
        "recipient_type": "individual",
        "to": recipient,
        "type": "text",
        "text": {"preview_url": False, "body": message},
    }

    for attempt in range(MAX_RATE_LIMIT_RETRIES + 1):
        try:
            response = httpx.post(
                url,
                headers=headers,
                json=payload,
                timeout=20.0,
            )
        except httpx.TimeoutException as exc:
            logger.warning("WhatsApp send timed out; outcome is uncertain.")
            raise WhatsAppSendUncertain(
                "Send timed out; verify delivery status before any retry."
            ) from exc
        except httpx.RequestError as exc:
            logger.warning("WhatsApp network error; outcome may be uncertain.")
            raise WhatsAppSendUncertain(
                "Network error during send; verify status before any retry."
            ) from exc

        # A 429 response indicates rate limiting. Retry only this definite
        # rejection, with a bounded delay, to avoid rapid repeated requests.
        if response.status_code == 429:
            if attempt < MAX_RATE_LIMIT_RETRIES:
                retry_after = response.headers.get("Retry-After", "")
                try:
                    delay = float(retry_after)
                    if delay < 0:
                        raise ValueError("Negative Retry-After")
                except (TypeError, ValueError, OverflowError):
                    delay = float(2 ** attempt)

                delay = min(delay, 30.0)
                logger.warning(
                    "WhatsApp rate limited the request; retry %d of %d "
                    "after %.1f seconds.",
                    attempt + 1,
                    MAX_RATE_LIMIT_RETRIES,
                    delay,
                )
                time.sleep(delay)
                continue

            raise WhatsAppSendError(
                "WhatsApp API continued rate limiting the request "
                "after the retry limit."
            )

        # A server error may not reliably establish whether the operation
        # was accepted. Do not resend automatically.
        if 500 <= response.status_code < 600:
            logger.warning(
                "WhatsApp API returned HTTP %s; outcome is uncertain.",
                response.status_code,
            )
            raise WhatsAppSendUncertain(
                "WhatsApp API server error; verify delivery before retry."
            )

        if response.is_error:
            logger.warning(
                "WhatsApp API rejected request (HTTP %s).",
                response.status_code,
            )
            raise WhatsAppSendError(
                "WhatsApp API rejected the request "
                f"(HTTP {response.status_code})."
            )

        try:
            return response.json()
        except ValueError as exc:
            raise WhatsAppSendUncertain(
                "Unexpected API response; verify status before any retry."
            ) from exc

    # Defensive fallback: the loop should always return or raise.
    raise WhatsAppSendError("WhatsApp send retry limit reached.")


def send_text_message(
    recipient: str,
    message: str,
    customer_message_timestamp: int | str | None = None,
) -> dict:
    """Send a customer reply only when enabled and within the 24-hour window."""
    return _send_text_message(
        recipient,
        message,
        "AUTO_REPLY_ENABLED",
        customer_message_timestamp=customer_message_timestamp,
        require_open_window=True,
    )


def send_staff_alert_message(recipient: str, message: str) -> dict:
    """Send a staff alert only if staff alerts are separately enabled."""
    return _send_text_message(
        recipient,
        message,
        "STAFF_ALERTS_ENABLED",
    )
